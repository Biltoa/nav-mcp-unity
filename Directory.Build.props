<Project>
  <!-- One version for every assembly in this repo. The daemon reports it over /health and in the
       MCP server info, and the Unity package's package.json carries the same number; a version
       that lives in three places is a version that disagrees with itself. -->
  <PropertyGroup>
    <Version>1.0.2</Version>
    <Product>Unity MCP Tool</Product>
    <Company>Unity MCP Tool</Company>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
