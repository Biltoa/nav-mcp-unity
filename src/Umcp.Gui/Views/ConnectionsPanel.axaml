<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Umcp.Gui.ViewModels"
             x:Class="Umcp.Gui.Views.ConnectionsPanel"
             x:DataType="vm:MainViewModel">

  <Border Classes="card">
    <StackPanel Spacing="16">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="Connect your MCP client" />
        <TextBlock Classes="muted"
                   Text="Writes the server into that app's settings for you. Nothing secret is stored in the file, and your other servers are left alone." />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Clients}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ClientRow">
            <Border Classes="row" Margin="0,0,0,10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Classes="dot" Margin="0,5,12,0" VerticalAlignment="Top" Fill="{Binding DotBrush}" />

                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                  <TextBlock Classes="muted" Text="{Binding Detail}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                  <Button Classes="outline" Content="Connect"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ConnectClientCommand}"
                          CommandParameter="{Binding}" IsVisible="{Binding NotConnected}" />
                  <Button Classes="link danger" Content="Disconnect"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DisconnectClientCommand}"
                          CommandParameter="{Binding}" IsVisible="{Binding Connected}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Expander Header="Another app, or do it by hand">
        <StackPanel Spacing="10" Margin="0,10,0,0">
          <TextBlock Classes="muted" Text="Paste this into any MCP client's config file:" />
          <TextBox Text="{Binding Snippet, Mode=OneWay}" IsReadOnly="True"
                   FontFamily="Consolas,Menlo,monospace" FontSize="12"
                   TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" />
          <Button Classes="link" Content="Copy" Click="OnCopySnippet" HorizontalAlignment="Left" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>
