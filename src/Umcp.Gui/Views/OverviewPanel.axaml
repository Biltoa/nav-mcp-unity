<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Umcp.Gui.ViewModels"
             x:Class="Umcp.Gui.Views.OverviewPanel"
             x:DataType="vm:MainViewModel">

  <!-- No card. The one thing this page is for sits in the middle of the space it has, so the
       emptiness around it reads as margin rather than as content that failed to load. -->
  <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
    <StackPanel Spacing="0" HorizontalAlignment="Center">

      <!-- The mark, barely there: it gives the composition a top edge without becoming a
           second thing to look at. -->
      <Image Source="/Assets/mark.png" Height="104" Opacity="0.09"
             HorizontalAlignment="Center" Margin="0,0,0,44" />

      <!-- Dot and headline centre as one group. Centring the text alone and then placing the
           dot to its left pushes the pair right by half the dot — which is exactly what it
           looked like. -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
        <Ellipse Width="14" Height="14" VerticalAlignment="Center">
          <Ellipse.Fill>
            <SolidColorBrush Color="{Binding ServerDot}" />
          </Ellipse.Fill>
        </Ellipse>
        <TextBlock Text="{Binding ServerHeadline}" FontSize="34" FontWeight="Bold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="{Binding ServerMeta}" Classes="muted" FontSize="14"
                 HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,0"
                 MaxWidth="620" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14"
                  Margin="0,34,0,0">
        <Button Classes="outline" Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"
                IsVisible="{Binding Running}" MinWidth="150" Height="46" />
        <Button Classes="primary" Content="{Binding ToggleServerLabel}"
                Command="{Binding ToggleServerCommand}" MinWidth="170" Height="46" />
      </StackPanel>

      <TextBlock Text="{Binding ServerFootnote}" Classes="faint"
                 HorizontalAlignment="Center" TextAlignment="Center" Margin="0,30,0,0"
                 MaxWidth="520" />
    </StackPanel>
  </Grid>
</UserControl>
