<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Umcp.Gui.ViewModels"
        xmlns:views="using:Umcp.Gui.Views"
        x:Class="Umcp.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NAV MCP"
        Width="1120" Height="820"
        MinWidth="900" MinHeight="620"
        Icon="/Assets/icon.ico"
        Background="{DynamicResource PageBackground}">

  <Grid RowDefinitions="Auto,*">

    <!-- ============================================================ title bar -->
    <!-- Custom chrome on Windows so the mark sits in the bar; macOS keeps its own traffic
         lights and gets an inset instead (see the code-behind). -->
    <Grid Grid.Row="0" Name="TitleBar" Background="{DynamicResource SidebarBackground}"
          ColumnDefinitions="Auto,*,Auto" Height="46" PointerPressed="OnTitleBarPressed">
      <StackPanel Name="Brand" Grid.Column="0" Orientation="Horizontal" Spacing="11"
                  Margin="16,0,0,0" VerticalAlignment="Center">
        <Image Source="/Assets/mark.png" Height="22" VerticalAlignment="Center" />
        <TextBlock Text="NAV MCP" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Name="WindowButtons" Grid.Column="2" Orientation="Horizontal">
        <Button Classes="chrome" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                Click="OnMinimise" ToolTip.Tip="Minimise" />
        <Button Classes="chrome" Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                Click="OnMaximise" ToolTip.Tip="Maximise" />
        <!-- Close hides to the tray: the server outliving its window is the design, and a close
             that stopped it would be a destructive action nobody asked for. -->
        <Button Classes="chrome close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                Click="OnClose" ToolTip.Tip="Close to tray" />
      </StackPanel>
    </Grid>

    <!-- ============================================================ body -->
    <Grid Grid.Row="1" ColumnDefinitions="216,*">

      <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Margin="0,14,12,0">
            <RadioButton Classes="nav" GroupName="nav" Content="Overview" IsChecked="{Binding IsOverview}" />
            <RadioButton Classes="nav" GroupName="nav" Content="Projects" IsChecked="{Binding IsProjects}" />
            <RadioButton Classes="nav" GroupName="nav" Content="Connections" IsChecked="{Binding IsConnections}" />
            <RadioButton Classes="nav" GroupName="nav" Content="Settings" IsChecked="{Binding IsSettings}" />
          </StackPanel>

          <!-- Visible without navigating: the sidebar is where someone glances to see whether
               anything is actually attached. -->
          <StackPanel Grid.Row="2" Margin="20,0,20,18" Spacing="6">
            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,10" />
            <TextBlock Classes="faint" Text="{Binding EditorSummary}" />
            <TextBlock Classes="faint" Text="{Binding VersionLine}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto">
        <!-- Overview centres in whatever space the window has, so it sits outside the scroller:
             a ScrollViewer sizes to its content and would pin the hero to the top. -->
        <views:OverviewPanel Grid.Row="0" IsVisible="{Binding IsOverview}" />

        <ScrollViewer Grid.Row="0" IsVisible="{Binding NotOverview}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" Padding="28,24,22,24">
          <Grid>
            <StackPanel Spacing="18" IsVisible="{Binding IsProjects}">
              <views:ServerCard />
              <views:ProjectsPanel />
            </StackPanel>

            <StackPanel Spacing="18" IsVisible="{Binding IsConnections}">
              <views:ConnectionsPanel />
            </StackPanel>

            <StackPanel Spacing="18" IsVisible="{Binding IsSettings}">
              <views:SettingsPanel />
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- One sentence about the last thing that happened, always visible. -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForeground}" FontSize="13" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
              <Button Classes="link" Content="Log folder" Command="{Binding OpenLogFolderCommand}" />
              <Button Classes="link" Content="Copy token" Click="OnCopyToken" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
